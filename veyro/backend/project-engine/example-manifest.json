{
  "schemaVersion": 1,
  "projectId": "demo-weather",
  "name": "Weather Demo",
  "kind": "app",
  "description": "A minimal weather app generated by VEYRO.",
  "screens": [
    {
      "id": "home",
      "name": "Home",
      "components": [
        {
          "id": "title",
          "type": "text",
          "properties": {"text": "Weather"},
          "actions": []
        },
        {
          "id": "refresh",
          "type": "button",
          "properties": {"text": "Refresh"},
          "actions": [
            {"type": "api_request", "params": {"providerId": "open-meteo", "operation": "forecast"}}
          ]
        }
      ]
    }
  ],
  "assets": [],
  "apiBindings": [],
  "build": {
    "packageId": "com.veyro.demo.weather",
    "versionName": "0.1.0",
    "minSdk": 21,
    "targetSdk": 35
  }
}
